{
  "type": "object",
  "properties": {
    "includeDomains": {
      "anyOf": [
        {
          "maxItems": 1200,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "excludeDomains": {
      "anyOf": [
        {
          "maxItems": 1200,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "startPublishedDate": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "endPublishedDate": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "numResults": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "moderation": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "contents": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContentsOptions"
        },
        {
          "type": "null"
        }
      ]
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "additionalQueries": {
      "anyOf": [
        {
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "deep",
        "deep-reasoning"
      ]
    },
    "category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "userLocation": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "country": {
                  "type": "string"
                }
              },
              "required": [
                "country"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "country": {
                  "type": "string"
                },
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              },
              "required": [
                "latitude",
                "longitude"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "compliance": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "hipaa"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "outputSchema": {
      "anyOf": [
        {
          "oneOf": [
            {
              "$ref": "#/$defs/OutputSchemaText"
            },
            {
              "$ref": "#/$defs/OutputSchemaObject"
            }
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "objective": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "userIdentifier": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "systemPrompt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "stream": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "query",
    "type"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Derived from https://exa.ai/docs/exa-spec.yaml on 2026-10-11. Deep modes only; deprecated fields removed; category accepts custom hints per its official description. Cross-field restrictions are checked by the helper.",
  "$defs": {
    "ContentsOptions": {
      "type": "object",
      "properties": {
        "text": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "properties": {
                    "maxCharacters": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1000000
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "includeHtmlTags": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "verbosity": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "compact",
                            "standard",
                            "full"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "includeSections": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "header",
                              "navigation",
                              "banner",
                              "body",
                              "sidebar",
                              "footer",
                              "metadata"
                            ]
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "excludeSections": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "header",
                              "navigation",
                              "banner",
                              "body",
                              "sidebar",
                              "footer",
                              "metadata"
                            ]
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "highlights": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "properties": {
                    "query": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "verbosity": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "low",
                            "medium",
                            "high"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "dynamic": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "maxCharacters": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1000000
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "query": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "$ref": "#/$defs/JsonValue"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "extras": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "links": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "imageLinks": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "richImageLinks": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "richLinks": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "codeBlocks": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "livecrawlTimeout": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 90000
            },
            {
              "type": "null"
            }
          ]
        },
        "maxAgeHours": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -1,
              "maximum": 720
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshotAsOf": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "string",
                  "format": "date"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "subpages": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "subpageTarget": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "minItems": 0,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "OutputSchemaText": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "text"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "OutputSchemaObject": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "object"
        },
        "description": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "JsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    }
  }
}
